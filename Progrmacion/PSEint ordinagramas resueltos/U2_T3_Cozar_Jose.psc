// Vamos a hacer un algortimo que introducida una edad nos diga si es maoría de edad o no
//
Algoritmo U2_T3_Cozar_Jose
	// Empezamos definiendo los valores
	Definir edad Como Entero;
	// Empezamos el algoritmo
	Escribir "Introduzaca su edad:";
	Leer edad;
	Si	edad>=18 Entonces
		Escribir "Eres mayor de edad";
	SiNo
		Escribir "Eres menor de edad";
	FinSi
FinAlgoritmo

